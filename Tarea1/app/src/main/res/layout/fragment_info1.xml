<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. TextView" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Muestra texto en pantalla. Se puede personalizar su fuente, color, tamaño y estilo." android:layout_marginBottom="16dp"/>

    <TextView android:id="@+id/tvTextoDinamico" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¡Soy un texto aburrido!" android:textSize="18sp" android:layout_marginBottom="16dp" android:gravity="center"/>

    <Button android:id="@+id/btnCambiarTexto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¡Dale estilo al texto!" />
</LinearLayout>