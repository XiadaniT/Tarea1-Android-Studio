<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. ImageView" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elemento diseñado para mostrar imágenes o íconos en la interfaz de usuario." android:layout_marginBottom="16dp"/>

    <ImageView android:id="@+id/ivImagen" android:layout_width="150dp" android:layout_height="150dp" android:src="@android:drawable/sym_def_app_icon" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btnOcultarImagen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ocultar / Mostrar Imagen" />
</LinearLayout>