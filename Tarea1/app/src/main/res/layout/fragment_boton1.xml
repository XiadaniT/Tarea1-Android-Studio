<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Botón Normal" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Botón clásico. Cumpliendo la rúbrica, este botón mostrará un 'Toast' (mensaje fugaz) al presionarlo." android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mostrar Toast" />
</LinearLayout>